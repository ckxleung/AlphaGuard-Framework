{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ckxleung/AlphaGuard-Framework/schemas/publication_artifact.schema.json",
  "title": "AlphaGuard Institutional Publication Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_id",
    "document_type",
    "title",
    "as_of",
    "generated_at",
    "telemetry_timestamp_matrix",
    "engine_version",
    "classification",
    "executive_summary",
    "claims",
    "sources",
    "scorecards",
    "disclosures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "TELEMETRY_NOTE",
        "DEEP_DIVE_WHITEPAPER"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "telemetry_timestamp_matrix": {
      "$ref": "#/$defs/telemetryTimestampMatrix"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claim_id",
          "claim_type",
          "statement",
          "source_refs",
          "methodology_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "FACT",
              "INFERENCE",
              "SCENARIO"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "methodology_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_type": {
                  "enum": [
                    "FACT",
                    "INFERENCE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "source_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "registry_document_id",
          "title",
          "url",
          "accessed_at",
          "content_hash",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "registry_document_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "PAGE",
                  "SECTION",
                  "TABLE",
                  "EXHIBIT",
                  "PARAGRAPH",
                  "CELL_RANGE",
                  "TIMESTAMP",
                  "LINE_RANGE",
                  "JSON_POINTER"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "scorecards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kernel_id",
          "target",
          "rigor_score",
          "data_quality_status",
          "structured_written_feedback"
        ],
        "properties": {
          "kernel_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "rigor_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "data_quality_status": {
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          },
          "structured_written_feedback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disclosures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informational_only",
        "independent_research",
        "derivatives_risk_disclosed",
        "synthetic_data"
      ],
      "properties": {
        "informational_only": {
          "const": true
        },
        "independent_research": {
          "const": true
        },
        "derivatives_risk_disclosed": {
          "const": true
        },
        "synthetic_data": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "telemetryTimestampMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetry_matrix_utc",
        "market_clocks"
      ],
      "properties": {
        "telemetry_matrix_utc": {
          "type": "string",
          "format": "date-time"
        },
        "market_clocks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "US_EQUITIES",
            "HK_EQUITIES",
            "CN_A_SHARES"
          ],
          "properties": {
            "US_EQUITIES": {
              "$ref": "#/$defs/marketClock"
            },
            "HK_EQUITIES": {
              "$ref": "#/$defs/marketClock"
            },
            "CN_A_SHARES": {
              "$ref": "#/$defs/marketClock"
            }
          }
        }
      }
    },
    "marketClock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "timezone_name",
        "timezone_abbreviation",
        "utc_offset",
        "schedule_model",
        "session_status",
        "calendar_basis",
        "holiday_calendar_applied"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "timezone_name": {
          "enum": [
            "America/New_York",
            "Asia/Hong_Kong",
            "Asia/Shanghai"
          ]
        },
        "timezone_abbreviation": {
          "type": "string",
          "minLength": 1
        },
        "utc_offset": {
          "type": "string",
          "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
        },
        "schedule_model": {
          "enum": [
            "US_EQUITIES_EXTENDED_MODEL",
            "HKEX_SECURITIES_MODEL",
            "SSE_MAIN_BOARD_MODEL"
          ]
        },
        "session_status": {
          "enum": [
            "PRE_MARKET",
            "PRE_OPEN_AUCTION",
            "REGULAR_TAPE",
            "LUNCH_BREAK",
            "CLOSING_AUCTION",
            "POST_MARKET",
            "CLOSED",
            "WEEKEND_CLOSED"
          ]
        },
        "calendar_basis": {
          "const": "WEEKDAY_SCHEDULE_ONLY"
        },
        "holiday_calendar_applied": {
          "const": false
        }
      }
    }
  }
}
