{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ckxleung/AlphaGuard-Framework/schemas/publication_artifact.schema.json",
  "title": "AlphaGuard Institutional Publication Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_id",
    "document_type",
    "title",
    "as_of",
    "generated_at",
    "engine_version",
    "classification",
    "executive_summary",
    "claims",
    "sources",
    "scorecards",
    "disclosures"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "enum": [
        "TELEMETRY_NOTE",
        "DEEP_DIVE_WHITEPAPER"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "claim_id",
          "claim_type",
          "statement",
          "source_refs",
          "methodology_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "enum": [
              "FACT",
              "INFERENCE",
              "SCENARIO"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "methodology_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "claim_type": {
                  "enum": [
                    "FACT",
                    "INFERENCE"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "source_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "source_id",
          "title",
          "url",
          "accessed_at"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "scorecards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "kernel_id",
          "target",
          "rigor_score",
          "data_quality_status",
          "structured_written_feedback"
        ],
        "properties": {
          "kernel_id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "rigor_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "data_quality_status": {
            "enum": [
              "APPROVED",
              "REJECTED"
            ]
          },
          "structured_written_feedback": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "disclosures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "informational_only",
        "independent_research",
        "derivatives_risk_disclosed",
        "synthetic_data"
      ],
      "properties": {
        "informational_only": {
          "const": true
        },
        "independent_research": {
          "const": true
        },
        "derivatives_risk_disclosed": {
          "const": true
        },
        "synthetic_data": {
          "type": "boolean"
        }
      }
    }
  }
}
